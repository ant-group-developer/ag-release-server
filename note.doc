export abstract class BaseCustomIDEntity {
	@PrimaryColumn({ default: generateId(), length: 10 })
	id: string;

	@CreateDateColumn({ type: 'timestamptz' })
	createdAt: Date;

	@UpdateDateColumn({ type: 'timestamptz' })
	updatedAt: Date;
}

