APP_PORT=

DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_RETRY_CONNECT=3


REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=


SWAGGER_USER=
SWAGGER_PASSWORD=

DEFAULT_USER_ID=8554043d-a902-43fe-b4c4-40a22b93dfe2
DEFAULT_USER_TYPE=user
DEFAULT_EMAIL=default@gmail.com
DEFAULT_NAME=default
DEFAULT_PASS=

# Email
EMAIL_USER=
EMAIL_PASS=
EMAIL_SERVICE=gmail

# GCS
GCS_PATH_KEY=./credential.json
GCS_PUBLIC_BUCKET=
GCS_PROTECTED_BUCKET=

# JWT
JWT_PRIVATE_KEY_PATH=./secrets/jwtRS256.key
JWT_PUBLIC_KEY_PATH=./secrets/jwtRS256.key.pub
JWT_ISSUER=ant-music-server
JWT_AUDIENCE=ant-music-web
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
JWT_KID=v1

# Backup
BACKUP_RCLONE_CONFIG_PATH=./database.rclone.conf
BACKUP_BASE_URL_GCS=
BACKUP_BASE_URL_CONSOLE_GCS=
BACKUP_BASE_URL_R2=
BACKUP_BASE_URL_CONSOLE_R2=

# DDEX
DDEX_PARTY_ID_SENDER=
DDEX_PARTY_NAME_SENDER=

# GRPC
GRPC_UPC_URL=
GRPC_ISRC_URL=

# Distribution v2 worker (disabled by default)
DISTRIBUTION_V2_ENABLED=false
DISTRIBUTION_V2_QUEUE_PREFIX=distribution-v2
DISTRIBUTION_V2_PACKAGE_SHARED_ROOT=/var/lib/ag-release/distribution-v2
DISTRIBUTION_V2_GENERATOR_REQUEST_TIMEOUT_MS=30000
DISTRIBUTION_V2_OUTBOX_POLL_INTERVAL_MS=2000
DISTRIBUTION_V2_PACKAGE_LEASE_MS=900000
DISTRIBUTION_V2_PACKAGE_RETENTION_MS=2592000000
DISTRIBUTION_V2_SFTP_PER_HOST_CONCURRENCY=2
DISTRIBUTION_V2_SFTP_RATE_LIMIT_MS=0
DISTRIBUTION_V2_SFTP_TIMEOUT_MS=300000
DISTRIBUTION_V2_SFTP_MAX_ATTEMPTS=3
DISTRIBUTION_V2_PARTNER_TIMEOUT_MS=432000000
DISTRIBUTION_V2_CI_POLL_INTERVAL_MS=60000
DISTRIBUTION_V2_CI_MAX_POLLS=120
DISTRIBUTION_V2_CI_PAGE_SIZE=200

# CRYPTO
CRYPTO_SECRET_KEY=

# R2 Storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PROTECTED_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PRIVATE_BASE_URL=

# Internal API Key (server-to-server auth)
INTERNAL_API_KEY=

# Vevo callback API Key
VEVO_CALLBACK_API_KEY=

# ClickHouse Standalone Database Connection
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=music_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Analytics report export worker
# Compose sets this explicitly for its worker container; leave empty to auto-detect cgroup CPU quota.
EXPORT_WORKER_THREADS=
EXPORT_CLICKHOUSE_MAX_MEMORY_USAGE=4294967296
EXPORT_CLICKHOUSE_MAX_EXECUTION_TIME=900
EXPORT_CLICKHOUSE_MAX_RESULT_ROWS=200000

# Comma-separated list of primary domains allowed for CORS and domain-resolve isPrimaryDomain check
# e.g. https://release.antmusic.net,https://app.antmusic.net
# PRIMARY_DOMAINS takes precedence; CORS_ORIGINS is used as fallback if PRIMARY_DOMAINS is not set
# The first domain is also used as the redirect base URL after Cloudflare OAuth callback
PRIMARY_DOMAINS=
CORS_ORIGINS=

# FTP / ETL Data Sync
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=username
FTP_PASSWORD=password
FTP_SECURE=explicit
FTP_BASE_PATH=/root
FTP_SYNC_MODE=manual
FTP_SYNC_CRON=0 2 * * *


# Cloudflare for SaaS Configuration
CF_ZONE_ID=
CF_API_TOKEN=
CF_FALLBACK_ORIGIN=

CF_OAUTH_CLIENT_ID=
CF_OAUTH_CLIENT_SECRET=
CF_OAUTH_REDIRECT_URI=

YOUTUBE_KEY_ENCRYPTION_SECRET=
